{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Qt SDK",
  "description": "Qt 6 build tools with Core, Widgets and WebEngine development files.",
  "version": "6.10.2",
  "image": "ghcr.io/containerpak/sdk-qt@sha256:0fb6a9c386e49f5b42a21d50b3023fd1ee488f41db6bfea91344699b54946ad8",
  "binaries": [
    "/usr/bin/qmake6",
    "/usr/bin/qtpaths6",
    "/usr/bin/qtdiag6",
    "/usr/bin/qtplugininfo6",
    "/usr/bin/qdbusviewer6",
    "/usr/bin/pixeltool6"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "addon_provider": {
    "id": "qt6",
    "slot": "sdk.qt",
    "mode": "exclusive",
    "exports": {
      "path": [
        "/usr/lib/qt6/bin"
      ]
    }
  },
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "bluetooth": false,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "hostNetwork": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
